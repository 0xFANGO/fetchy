{
	"manifest_version": 3,
	"name": "Fetchy 视频下载",
	"version": "0.2.0",
	"description": "识别并下载 YouTube、B站、小红书和抖音的单个视频，保存到你的文件夹。",
	"minimum_chrome_version": "120",
	"key": "",
	"permissions": ["activeTab", "storage", "nativeMessaging", "scripting"],
	"host_permissions": [
		"https://*.xiaohongshu.com/*",
		"https://*.douyin.com/*",
		"https://*.iesdouyin.com/*"
	],
	"background": {
		"service_worker": "background.mjs",
		"type": "module"
	},
	"action": {
		"default_title": "Fetchy 视频下载",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' https: data:; style-src 'self'"
	}
}
