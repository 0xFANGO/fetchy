{
	"name": "fango-video-downloader",
	"version": "0.2.0",
	"private": true,
	"description": "Download single videos from YouTube, Bilibili, Xiaohongshu and Douyin to a local folder, from a browser extension, the CLI or Node.",
	"keywords": [
		"bilibili",
		"browser-extension",
		"douyin",
		"downloader",
		"manifest-v3",
		"video",
		"xiaohongshu",
		"youtube",
		"yt-dlp"
	],
	"homepage": "https://github.com/0xFANGO/fango-video-downloader#readme",
	"bugs": {
		"url": "https://github.com/0xFANGO/fango-video-downloader/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xFANGO/fango-video-downloader.git"
	},
	"bin": {
		"fango-download": "./bin/fango-download.mjs"
	},
	"files": [
		"src",
		"bin",
		"native",
		"extension",
		"scripts",
		"LICENSE",
		"README.md",
		"README.zh-CN.md"
	],
	"type": "module",
	"exports": "./src/index.mjs",
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "npm run fmt:check && npm run lint",
		"doctor": "node scripts/doctor.mjs",
		"extension:build": "node scripts/build-extension.mjs",
		"native:install": "node native/install.mjs",
		"resolve": "node bin/fango-download.mjs resolve",
		"download": "node bin/fango-download.mjs download"
	},
	"devDependencies": {
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0"
	},
	"engines": {
		"node": ">=22"
	}
}
