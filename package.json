{
	"name": "fetchy",
	"version": "0.3.1",
	"private": true,
	"description": "Save videos from social media posts to local MP4 files with a browser extension, CLI or Node API.",
	"keywords": [
		"bilibili",
		"browser-extension",
		"douyin",
		"downloader",
		"manifest-v3",
		"video",
		"xiaohongshu",
		"youtube",
		"yt-dlp"
	],
	"homepage": "https://github.com/0xFANGO/fetchy#readme",
	"bugs": {
		"url": "https://github.com/0xFANGO/fetchy/issues"
	},
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/0xFANGO/fetchy.git"
	},
	"bin": {
		"fetchy": "./bin/fetchy.mjs"
	},
	"files": [
		"src",
		"bin",
		"native",
		"desktop",
		"extension",
		"scripts",
		"requirements.txt",
		"LICENSE",
		"README.md",
		"README.zh-CN.md"
	],
	"type": "module",
	"exports": "./src/index.mjs",
	"scripts": {
		"test": "node --test test/*.test.mjs",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"check": "npm run fmt:check && npm run lint",
		"doctor": "node scripts/doctor.mjs",
		"deps:install": "node scripts/install-deps.mjs",
		"desktop:build": "node scripts/build-desktop.mjs",
		"extension:build": "node scripts/build-extension.mjs",
		"extension:pack": "node scripts/pack-extension.mjs",
		"version": "node scripts/sync-version.mjs && oxfmt extension/manifest.json && git add extension/manifest.json",
		"native:install": "node native/install.mjs",
		"resolve": "node bin/fetchy.mjs resolve",
		"download": "node bin/fetchy.mjs download"
	},
	"devDependencies": {
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0"
	},
	"engines": {
		"node": ">=22"
	}
}
